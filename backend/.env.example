# Infrastructure (R-CFG-08) — copy to `.env` and adjust. Never commit real secrets.

APP_ENV=development
APP_DEBUG=true
APP_PUBLIC_URL=http://localhost:8000

# PostgreSQL 16 + pgvector (Windows host — hostname is localhost, not Docker `db`)
DATABASE_URL=postgresql+asyncpg://sales_agent:sales_agent@localhost:5432/sales_agent
# Optional superuser URL for CREATE ROLE / CREATE EXTENSION:
# DATABASE_OWNER_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sales_agent

# Redis 7 (cache, ARQ, rate limits, pub/sub)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sales-agent
S3_REGION=us-east-1
S3_USE_SSL=false

# SMTP (Mailpit in local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
SMTP_USE_TLS=false

# Auth / crypto (generate strong values for non-dev)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
SECRETS_ENCRYPTION_KEY=change-me-32-byte-base64-or-fernet-key

# Observability (optional in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sales-agent-api
GLITCHTIP_DSN=

# AI platform (Phase 07+)
AI_PLATFORM_MODE=in_process
